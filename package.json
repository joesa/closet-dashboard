{
  "name": "closet-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "cp ../closet-widget/dist/widget.js public/widget.js 2>/dev/null || true",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx --tsconfig worker/tsconfig.json worker/src/index.ts",
    "worker:migrate": "tsx --tsconfig worker/tsconfig.json worker/src/migrate.ts",
    "test:custom-site-sync": "node scripts/check-custom-site-core-sync.mjs",
    "check:worker-env": "node scripts/check-worker-env-checklist.mjs",
    "audit:ai-tells": "tsx scripts/audit-fleet-ai-tells.mjs",
    "audit:design-capacity": "tsx scripts/audit-design-capacity.ts",
    "audit:template-quality": "node scripts/audit-template-quality.mjs",
    "remediate:ai-tells": "tsx scripts/remediate-fleet-ai-tells.ts",
    "stripe:verify": "node scripts/stripe-verify.mjs",
    "stripe:catalog": "node scripts/stripe-setup-catalog.mjs",
    "backfill:widget-domain": "node scripts/backfill-widget-domain.mjs",
    "backfill:widget-domain:apply": "node scripts/backfill-widget-domain.mjs --apply"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@ditchtheform/pricing": "file:./packages/pricing",
    "@google/generative-ai": "^0.24.1",
    "@sentry/nextjs": "^10.66.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "graphile-worker": "^0.17.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "openai": "^6.39.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "stripe": "^22.1.1",
    "tsx": "^4.23.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^10.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
