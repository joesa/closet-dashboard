# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/public/widget.js

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# CI sibling checkouts (customSite sync)
.ci-siblings/

# local accidental dumps
et -a

# typescript
*.tsbuildinfo
next-env.d.ts

# OCI / Oracle Cloud credentials — never commit (this repo is public)
my_oci
.oci/
oci_api_key*
*.oci.config
