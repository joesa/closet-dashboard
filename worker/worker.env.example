# Graphile Worker environment. Copy the real values into the repo-root
# .env.local on the worker host (docker-compose.prod.yml reads that file).
#
# Kept in sync with docs/ops/GRAPHILE_WORKER.md via CI:
#   npm run check:worker-env

# Supabase Postgres, SESSION mode on port 5432.
# The transaction pooler (:6543) breaks LISTEN/NOTIFY and is rejected at runtime
# by getGraphileDatabaseUrl() in src/lib/jobs/databaseUrl.ts.
DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
CUSTOM_SITE_CLAUDE_MODEL=

# Base domain for provisioned tenant subdomains. Set this. resolveSubdomain()
# falls back to 'localhost' when it is unset, so a missing value does not throw
# — it quietly provisions tenants onto subdomains that resolve nowhere.
TENANT_BASE_DOMAIN=

# Revalidates a tenant site after the worker publishes it. Without it the
# published site can serve stale content.
REVALIDATE_SECRET=

# Launch emails. sendIntakeLaunchEmail() returns early when unset, so
# auto-launch completes silently without notifying anyone.
RESEND_API_KEY=

# Optional. Concurrent jobs per worker process (default 3).
# Each job is a multi-minute AI call; the pool opens WORKER_CONCURRENCY + 2
# Postgres connections, so keep it under the Supabase session limit.
# WORKER_CONCURRENCY=3
