# Graphile Worker environment. Copy the real values into the repo-root
# .env.local on the worker host (docker-compose.prod.yml reads that file).
#
# Kept in sync with docs/ops/GRAPHILE_WORKER.md via CI:
#   npm run check:worker-env

# Supabase Postgres, SESSION mode on port 5432.
# The transaction pooler (:6543) breaks LISTEN/NOTIFY and is rejected at runtime
# by getGraphileDatabaseUrl() in src/lib/jobs/databaseUrl.ts.
DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
CUSTOM_SITE_CLAUDE_MODEL=

# Optional. Concurrent jobs per worker process (default 3).
# Each job is a multi-minute AI call; the pool opens WORKER_CONCURRENCY + 2
# Postgres connections, so keep it under the Supabase session limit.
# WORKER_CONCURRENCY=3
