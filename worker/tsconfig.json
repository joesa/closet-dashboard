{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["../src/*"]
    },
    "baseUrl": "."
  },
  // Only the worker's own files. `../src` still resolves through `paths` — it
  // was *included* here as well, which pulled the entire Next app into a config
  // with no `jsx` and no Next types and produced 279 phantom errors, which is
  // why nothing ever typechecked the worker at all.
  "include": ["./**/*.ts"]
}
