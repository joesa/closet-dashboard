# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only. Used by the Stripe webhook and the
# entitlement gate. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres (session mode, port 5432) for Graphile Worker + enqueueJob.
# Do NOT use the transaction pooler (:6543) — LISTEN/NOTIFY will break.
# Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=

# Email + SMS
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Exact public URL Twilio posts to (required for signature validation).
TWILIO_WEBHOOK_URL=https://your-dashboard.example.com/api/webhooks/twilio
# Cold SMS outreach caps / follow-ups
SMS_MAX_DAILY=50
SMS_STEP2_DELAY_DAYS=2
# Set to false to allow SMS outside Mon–Fri 9–17 America/Chicago
SMS_SEND_WINDOW_ENFORCE=true
# Positive-reply / campaign link placeholders
OUTREACH_LOOM_URL=
OUTREACH_LANDING_URL=https://www.ditchtheform.com/#demo

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Stripe catalog — run: npm run stripe:catalog (creates products/prices via API)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_STANDARD_BUILD=price_...
STRIPE_PRICE_AI_PREMIUM_FULL=price_...
STRIPE_PRICE_AI_PREMIUM_DEPOSIT=price_...
STRIPE_PRICE_AI_PREMIUM_BALANCE=price_...
STRIPE_PRICE_SITE_MAINTENANCE_MONTHLY=price_...
STRIPE_PRICE_SITE_MAINTENANCE_YEARLY=price_...
# Optional: pin the Stripe API version. Leave blank to use the SDK default.
STRIPE_API_VERSION=

# Public site URL — used for emails, Stripe returns, intake verify links.
# Production: https://www.ditchtheform.com (never closetquotes.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Widget API origin (embed data-api-url). Defaults to NEXT_PUBLIC_SITE_URL or ditchtheform.com.
NEXT_PUBLIC_APP_URL=
# CDN loader for the content-addressed, integrity-protected widget release.
NEXT_PUBLIC_WIDGET_CDN_URL=https://closet-widget.vercel.app/loader.js
# Must match custom-closets-websites ADMIN_BYPASS_SECRET for admin "Review" links.
ADMIN_BYPASS_SECRET=
# Dedicated secret for POST /api/revalidate on tenant sites (preferred over bypass).
# Must match custom-closets-websites REVALIDATE_SECRET.
REVALIDATE_SECRET=
# Optional error monitoring (Sentry). Leave empty to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# (Tenant sites use each tenant's own custom domain from the `domains` table.
# Admin "Review" links open https://<that-domain>. Dev `.localhost` fixtures are
# only previewable when running the sites app locally.)

# Tenant site hosting (custom-closets-websites). Provisioning creates a platform
# subdomain `<subdomain>.TENANT_BASE_DOMAIN`. In production set this to the
# wildcard apex you point at the websites project (e.g. ditchtheform.com) so the
# subdomain resolves to a real wildcard-SSL host. Defaults to localhost for dev.
TENANT_BASE_DOMAIN=localhost
# Vercel API — lets provisioning attach a prospect's custom domain (from their
# intake) to the websites project and auto-provision SSL. Best-effort: if unset,
# the domain is still recorded in the `domains` table and can be added manually.
# Token needs domain access for the team/project that hosts custom-closets-websites.
# For domain purchase, the token also needs Domains Registrar scope.
VERCEL_API_TOKEN=
# Project id of the custom-closets-websites Vercel project (Project Settings → General).
VERCEL_WEBSITES_PROJECT_ID=
# Optional: Vercel team id if the websites project lives under a team.
VERCEL_TEAM_ID=

# Domain management (BYO + Vercel Registrar purchase)
# Set true to allow contractors/admins to buy .com/.net/.io via Vercel Registrar.
# Purchase cost is folded into hosting/maintenance (no Stripe domain checkout).
DOMAIN_PURCHASE_ENABLED=false
# Max wholesale price (cents) the platform will auto-buy without ops review.
DOMAIN_MAX_PURCHASE_CENTS=5000
# Comma-separated TLDs offered in search / purchase.
DOMAIN_ALLOWED_TLDS=com,net,io
# Platform registrant contact (WHOIS) — required when DOMAIN_PURCHASE_ENABLED=true.
DOMAIN_REGISTRANT_FIRST_NAME=
DOMAIN_REGISTRANT_LAST_NAME=
DOMAIN_REGISTRANT_EMAIL=
DOMAIN_REGISTRANT_PHONE=
DOMAIN_REGISTRANT_ADDRESS1=
DOMAIN_REGISTRANT_ADDRESS2=
DOMAIN_REGISTRANT_CITY=
DOMAIN_REGISTRANT_STATE=
DOMAIN_REGISTRANT_ZIP=
DOMAIN_REGISTRANT_COUNTRY=
DOMAIN_REGISTRANT_COMPANY=

# Google Gemini — routine text/content generation, second Full redesign provider,
# and primary surgical-edit model.
GEMINI_API_KEY=
# Optional override for surgical / Gemini text (default: gemini-pro-latest)
CUSTOM_SITE_GEMINI_MODEL=
# Optional Full redesign fallback override (default: gemini-3.1-pro-preview)
FULL_REDESIGN_GEMINI_MODEL=

# Firecrawl — metro market price-bounds research at provision time (Phase 5).
# Optional; when unset, catalog defaults still apply and provision never blocks.
FIRECRAWL_API_KEY=
# Optional self-hosted base (default: https://api.firecrawl.dev)
FIRECRAWL_API_URL=

# Anthropic — third Full redesign provider and last-resort surgical fallback.
ANTHROPIC_API_KEY=
# Optional Anthropic override for surgical / chat Claude (default: claude-sonnet-5).
# Also overrides Full redesign when FULL_REDESIGN_ANTHROPIC_MODEL is unset.
CUSTOM_SITE_CLAUDE_MODEL=
# Optional Full redesign last-resort override (default: claude-opus-5)
FULL_REDESIGN_ANTHROPIC_MODEL=

# OpenAI — primary Full redesign provider, surgical-edit fallback after Gemini,
# plus image generation for hero/product images.
# Server-only; never expose to the browser.
OPENAI_API_KEY=
# Optional override for surgical OpenAI text (default: gpt-4.1)
CUSTOM_SITE_OPENAI_MODEL=
# Optional Full redesign primary override (default: gpt-5.6-sol)
FULL_REDESIGN_OPENAI_MODEL=

# Demo account anti-abuse. The demo contractor id is the tenant whose widget is
# embedded on marketing pages; calculate/send-lead gate it to allowed origins.
DEMO_CONTRACTOR_ID=
NEXT_PUBLIC_DEMO_CONTRACTOR_ID=
# Comma-separated origins allowed to embed the demo widget.
DEMO_ALLOWED_ORIGINS=
NEXT_PUBLIC_DEMO_ALLOWED_ORIGINS=

# Shared secret guarding the demo-reset cron route (/api/cron/reset-demo).
# Vercel Cron sends this as a Bearer token.
CRON_SECRET=
# Async provision worker (/api/cron/process-provision-jobs)
PROVISION_BATCH_SIZE=5
PROVISION_MAX_ATTEMPTS=3
# Auto-launch: a submitted intake provisions, runs its first Full redesign,
# publishes it, and goes live with no admin click. Set to false to restore the
# manual "Approve & Go Live" + admin-triggered Full redesign flow.
AUTO_LAUNCH_REDESIGN=true

# Optional text-generation cost telemetry. Set these to current contracted
# USD rates per million tokens; unset rates leave estimatedCostUsd omitted.
# AI_COST_ANTHROPIC_INPUT_PER_MILLION_USD=
# AI_COST_ANTHROPIC_OUTPUT_PER_MILLION_USD=
# AI_COST_GEMINI_INPUT_PER_MILLION_USD=
# AI_COST_GEMINI_OUTPUT_PER_MILLION_USD=
# AI_COST_OPENAI_INPUT_PER_MILLION_USD=
# AI_COST_OPENAI_OUTPUT_PER_MILLION_USD=
# If that first redesign exhausts its retries, still reveal the site on the
# engine template rather than leaving the customer invisible. Set to false to
# keep it gated for an admin instead.
AUTO_LAUNCH_REVEAL_ON_REDESIGN_FAILURE=true
# Daily caps for admin AI routes (generate-site / generate-images)
AI_GENERATE_DAILY_MAX=50

# Public intake (/get-started) — Cloudflare Turnstile
# Prefer TURNSTILE_SECRET (Spin); TURNSTILE_SECRET_KEY kept as legacy alias.
TURNSTILE_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
INTAKE_FROM_EMAIL=DitchTheForm <admin@ditchtheform.com>

# Tiered intake pricing (cents). AI Premium requires 30% deposit before image studio.
# Used on /intake and mirrored to the landing page via next.config env passthrough.
INTAKE_TIER_STANDARD_CENTS=129900
INTAKE_TIER_AI_PREMIUM_CENTS=249900
INTAKE_AI_MAX_ATTEMPTS_PER_SLOT=3

# Site maintenance after launch (cents). Yearly = 10× monthly (2 months free).
SITE_MAINTENANCE_MONTHLY_CENTS=11900
SITE_MAINTENANCE_YEARLY_CENTS=119000

# Widget-only subscription (cents). Yearly = 10× monthly (2 months free).
WIDGET_SUBSCRIPTION_MONTHLY_CENTS=9900
WIDGET_SUBSCRIPTION_YEARLY_CENTS=99000

# Scraper trigger (admin "Run scraper" action).
# In production set the Apify (or other) Actor run webhook URL + token.
SCRAPER_TRIGGER_WEBHOOK_URL=
SCRAPER_TRIGGER_WEBHOOK_TOKEN=
# Local-dev fallback: when not on Vercel, the action shells out to the scraper.
SCRAPER_LOCAL_DIR=../closet-scraper
SCRAPER_LOCAL_RUN_COMMAND=npm run start:dev

# Instantly automation (scraper webhook receiver)
# Use the same value as closet-scraper WEBHOOK_AUTH_TOKEN.
INSTANTLY_RECEIVER_AUTH_TOKEN=
# Auth for Instantly Unsubscribed webhook (/api/webhooks/instantly).
# Falls back to INSTANTLY_RECEIVER_AUTH_TOKEN if unset.
INSTANTLY_WEBHOOK_SECRET=
# Shared bearer token for scraper->dashboard control-plane APIs.
# Use the same value as SCRAPER_CONTROL_PLANE_TOKEN in closet-scraper.
SCRAPER_CONTROL_PLANE_TOKEN=
INSTANTLY_MIN_LEADS_PER_BATCH=1
INSTANTLY_WARMUP_MODE=true
INSTANTLY_AUTO_START=false

# Instantly API settings
INSTANTLY_API_KEY=
INSTANTLY_API_BASE_URL=https://api.instantly.ai/api/v2
INSTANTLY_API_AUTH_HEADER=Authorization
INSTANTLY_API_AUTH_PREFIX=Bearer
INSTANTLY_CAMPAIGNS_PATH=/campaigns
INSTANTLY_CAMPAIGN_SEARCH_QUERY_PARAM=search
INSTANTLY_UPDATE_CAMPAIGN_PATH=/campaigns/{campaignId}
INSTANTLY_IMPORT_LEADS_PATH=/leads/add
INSTANTLY_START_CAMPAIGN_PATH=/campaigns/{campaignId}/activate
# Blocklist sync from Twilio STOP → Instantly
INSTANTLY_BLOCKLIST_PATH=/block-lists-entries

# ── Spec builds: unattended sites for cold leads ──────────────────────────────
# Master switch for unattended operation. When false (the default), a finished
# scraper run queues nothing and no build advances on its own; leads added by
# hand in /admin/spec-builds still queue and can be driven with the buttons.
SPEC_BUILD_ENABLED=false
# Builds a scraper run may queue per UTC day.
SPEC_BUILD_DAILY_MAX=5
# How many builds may be mid-pipeline at once. This is the spend throttle that
# matters: the daily cap limits queueing, which a backlog carried over from
# earlier days sails straight past. Daily spend is separately bounded by
# AI_GENERATE_DAILY_MAX, which the spec path counts against.
SPEC_BUILD_MAX_IN_FLIGHT=2
# Product images generated per build — one per service, so this is a direct
# cost multiplier.
SPEC_BUILD_MAX_SERVICES=5
# Variants generated per image slot. One, because nobody is choosing.
SPEC_BUILD_IMAGE_VARIANTS=1
# Domain for the per-build placeholder owner address (spec+<id>@...). Must be
# one we control: it is never the business's real email, so that no account or
# mail reaches them before they have agreed to anything.
SPEC_PLACEHOLDER_EMAIL_DOMAIN=ditchtheform.com
# Required for research — Maps and Facebook are unreadable without it.
FIRECRAWL_API_KEY=
# ── Spec build offers (Phase 4) ───────────────────────────────────────────────
# Signs the per-tenant, expiring preview token sent in the offer SMS. NEVER use
# admin_bypass for that: its secret is global and would expose every gated
# tenant on the platform to anyone the message is forwarded to.
SPEC_PREVIEW_SECRET=
# Discount on the AI Premium list price, in basis points. 5000 = 50% off.
SPEC_OFFER_DISCOUNT_BPS=5000
# How long the owner has, and when the reminder goes out before the deadline.
SPEC_OFFER_DEADLINE_HOURS=168
SPEC_OFFER_REMINDER_HOURS=24
# Grace period between an offer lapsing and the site actually being deleted, so
# a late "yes" is recoverable.
SPEC_PURGE_GRACE_HOURS=24
# THE guard against texting a real business by accident. While this holds any
# numbers, no other number can be messaged whatever the pipeline decides. Keep
# it set to your own phone for the first weeks of live running.
SPEC_BUILD_SMS_ALLOWLIST=
